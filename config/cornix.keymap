#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    behaviors {
        // 1. tap_dance（左右反転・確定版）
        td_shift_caps: td_shift_caps {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LSHFT>, <&kp CAPSLOCK>;
        };
        td_shift_mission: td_shift_mission {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp RSHFT>, <&kp C_AC_DESKTOP_SHOW_ALL_WINDOWS>;
        };

        // 2. 長押し Control / 単押し Escape
        mt_esc_ctrl: mt_esc_ctrl {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <200>;
        };

        // 3. 長押し Command / 単押し Delete Forward (DEL)
        mt_ret_cmd: mt_ret_cmd {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <200>;
        };

        // 4. レイヤー切り替え用 hold-tap
        // 長押し: Raise (Layer 2) / 単押し: TAB
        mt_tab_l2: mt_tab_l2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <200>;
        };

        // 長押し: Lower (Layer 1) / 単押し: BackSpace (BSPC)
        mt_del_l1: mt_del_l1 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <200>;
        };

        // 5. 長押し 3rdレイヤー(Layer 4) / 単押し Return
        mt_ret_l4: mt_ret_l4 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // 0. ベースレイヤー (Default)
        default_layer {
            display-name = "Base";
            bindings = <
&kp TAB            &kp Q    &kp W     &kp E             &kp R      &kp T                               &kp Y      &kp U      &kp I          &kp O          &kp P         &kp BSPC
&kp LCTRL          &kp A    &kp S     &kp D             &kp F      &kp G                               &kp H      &kp J      &kp K          &kp L          &kp MINUS     &kp ENTER
&td_shift_mission  &kp Z    &kp X     &kp C             &kp V      &kp B          &kp C_MUTE  &none    &kp N      &kp M      &kp COMMA      &kp DOT        &kp UP        &td_shift_caps
&mt_ret_l4 4 ENTER &kp LALT &kp LGUI  &mt_esc_ctrl LCTRL ESC  &mt_tab_l2 2 TAB  &kp SPACE      &kp SPACE   &mt_del_l1 1 BSPC  &mt_ret_cmd LGUI DEL &kp LEFT &kp DOWN    &kp RIGHT
            >;
            // 💎 Baseツマミ：ハイパー ＋ F1/F2/F3/F4
            sensor-bindings = <&inc_dec_kp LC(LS(LA(LG(F1)))) LC(LS(LA(LG(F2)))) &inc_dec_kp LC(LS(LA(LG(F3)))) LC(LS(LA(LG(F4))))>;
        };

        // 1. Lowerレイヤー（テンキー・算数部屋）     
        Lower_layer {
            display-name = "Lower";
            bindings = <
&trans  &kp EQUAL       &kp FSLH        &kp ASTERISK     &kp MINUS           &kp PLUS                                &kp KP_MINUS   &kp KP_N7  &kp KP_N8  &kp KP_N9   &kp F21       &trans
&trans  &kp KP_EQUAL    &kp KP_SLASH    &kp KP_ASTERISK  &kp KP_MINUS        &kp KP_PLUS                             &kp KP_N0      &kp KP_N4  &kp KP_N5  &kp KP_N6   &kp KP_DOT    &trans
&trans  &kp F18         &kp F19         &kp F20          &kp DLLR            &kp F22        &kp C_MUTE  &none        &kp F24        &kp KP_N1  &kp KP_N2  &kp KP_N3   &kp UP        &trans
&trans  &trans          &trans          &trans           &trans              &trans                                  &trans         &trans     &trans     &trans      &trans        &trans
            >;
            // 💎 Lowerツマミ：ハイパー ＋ F5/F6/F7/F8
            sensor-bindings = <&inc_dec_kp LC(LS(LA(LG(F5)))) LC(LS(LA(LG(F6)))) &inc_dec_kp LC(LS(LA(LG(F7)))) LC(LS(LA(LG(F8))))>;
        };

        // 2. Raiseレイヤー（★レターキーエリアをご希望通り F15, F16, F17 へ精密スライド！）
        Raise_layer {
            display-name = "Raise";
            bindings = <
&trans  &kp LT     &kp GT      &kp LPAR     &kp RPAR     &kp F15                            &kp AT      &kp F23      &kp HASH    &kp TILDE   &none        &trans
&trans  &kp LEFT   &kp DOWN    &kp UP       &kp RIGHT    &kp F16                            &kp EXCL    &kp QMARK    &kp AMPS    &kp PRCNT   &kp PIPE     &trans
&trans  &kp LBRC   &kp RBRC    &kp LBKT     &kp RBKT     &kp F17        &kp C_MUTE  &none   &kp SEMI    &kp COLON    &kp SQT     &kp DQT     &kp UP       &trans
&trans  &trans     &trans      &trans       &trans       &trans                             &trans      &trans       &trans      &trans      &trans       &trans
            >;
            // 💎 Raiseツマミ：ハイパー ＋ F9/F10/F11/F12
            sensor-bindings = <&inc_dec_kp LC(LS(LA(LG(F9)))) LC(LS(LA(LG(F10)))) &inc_dec_kp LC(LS(LA(LG(F11)))) LC(LS(LA(LG(F12))))>;
        };

        // 3. 予備レイヤー (naginata)
        naginata_layer {
            display-name = "Extra1";
            bindings = <
&trans  &trans  &trans  &trans  &trans     &trans                    &trans  &trans   &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans     &trans                    &trans  &trans   &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans     &trans  &kp C_MUTE &none  &trans  &trans   &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans     &trans                    &trans  &trans   &trans  &trans  &trans  &trans
            >;
            // 💎 naginataツマミ：3つ装飾 ＋ F1/F2/F3/F4
            sensor-bindings = <&inc_dec_kp LC(LA(LG(F1))) LC(LA(LG(F2))) &inc_dec_kp LC(LA(LG(F3))) LC(LA(LG(F4)))>;
        };

        // 4. システムレイヤー (3rd)
        third_layer {
            display-name = "3rd";
            bindings = <
&trans  &kp N1        &kp N2         &kp N3          &kp N4          &kp N5                            &kp N6        &kp N7        &kp N8       &kp N9          &kp N0   &trans
&trans  &kp CARET     &kp GRAVE      &kp LG(LS(N3))  &kp LG(LS(N4))  &kp LG(LS(N5))                    &kp LS(LEFT)  &kp LS(DOWN)  &kp LS(UP)   &kp LS(RIGHT)   &none    &trans
&trans  &bt BT_SEL 0  &bt BT_SEL 1   &bt BT_SEL 2    &bt BT_CLR      &none         &kp C_MUTE  &none   &kp HOME      &kp PG_DN     &kp PG_UP    &kp END         &kp UP   &trans
&trans  &trans        &trans         &trans          &trans          &trans                            &trans        &trans        &trans       &trans          &trans   &trans
            >;
            // 💎 3rdツマミ：3つ装飾 ＋ F5/F6/F7/F8
            sensor-bindings = <&inc_dec_kp LC(LA(LG(F5))) LC(LA(LG(F6))) &inc_dec_kp LC(LA(LG(F7))) LC(LA(LG(F8)))>;
        };

        // 5. 予約レイヤー
        extra2 {
            display-name = "Extra2";
            status = "reserved";
            bindings = <
&trans &trans &trans &trans &trans &trans                  &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans                  &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans                  &trans &trans &trans &trans &trans &trans
            >;
            sensor-bindings = <&inc_dec_kp LC(LS(LA(LG(F1)))) LC(LS(LA(LG(F2)))) &inc_dec_kp LC(LS(LA(LG(F3)))) LC(LS(LA(LG(F4))))>;
        };
    };
};
