#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    behaviors {
        // 1. tap_dance（ShiftとCapsLock、および右端のMission Control用）
        td_shift_caps: tap_dance {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LSHFT>, <&kp CAPSLOCK>;
        };
        td_shift_mission: tap_dance_mission {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp RSHFT>, <&kp C_AC_DESKTOP_SHOW_ALL_WINDOWS>;
        };

        // 2. 長押し Control / 単押し Escape
        mt_esc_ctrl: mt_esc_ctrl {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
        };

        // 3. 長押し Command / 単押し Delete Forward (DEL)
        mt_ret_cmd: mt_ret_cmd {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
        };

        // 4. レイヤー切り替え用 hold-tap
        // 長押し: Raise (Layer 2) / 単押し: TAB
        mt_tab_l2: mt_tab_l2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
        };

        // 長押し: Lower (Layer 1) / 単押し: BackSpace (BSPC)
        mt_del_l1: mt_del_l1 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // 0. ベースレイヤー
        default_layer {
            display-name = "Base";
            bindings = <
&kp TAB         &kp Q    &kp W     &kp E             &kp R      &kp T                               &kp Y      &kp U      &kp I          &kp O          &kp P         &kp BSPC
&kp LCTRL       &kp A    &kp S     &kp D             &kp F      &kp G                               &kp H      &kp J      &kp K          &kp L          &kp MINUS     &kp ENTER
&td_shift_caps  &kp Z    &kp X     &kp C             &kp V      &kp B          &kp C_MUTE  &none    &kp N      &kp M      &kp COMMA      &kp DOT        &kp UP        &td_shift_mission
&mo 4           &kp LALT &kp LGUI  &mt_esc_ctrl LCTRL ESC &kp SPACE &mt_tab_l2 2 TAB           &mt_del_l1 1 BSPC &kp SPACE &mt_ret_cmd LGUI DEL &kp LEFT &kp DOWN    &kp RIGHT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        // 1. Lowerレイヤー（テンキー・記号用）
        Lower_layer {
            display-name = "Lower";
            bindings = <
&trans  &kp LG(LS(N3))  &kp LG(LS(N4))  &kp LG(LS(N5))   &kp SEMI            &kp COLON                               &kp KP_MINUS   &kp KP_N7  &kp KP_N8  &kp KP_N9   &kp KP_COMMA &trans
&trans  &kp EQUAL       &kp FSLH        &kp ASTERISK     &kp MINUS           &kp PLUS                                &kp KP_N0      &kp KP_N4  &kp KP_N5  &kp KP_N6   &kp KP_DOT   &trans
&trans  &kp DLLR        &none           &none            &none               &none          &kp C_MUTE  &none        &none          &kp KP_N1  &kp KP_N2  &kp KP_N3   &kp UP       &trans
&trans  &trans          &trans          &trans           &trans              &trans                                  &trans         &trans     &trans     &trans      &trans       &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        // 2. Raiseレイヤー
        Raise_layer {
            display-name = "Raise";
            bindings = <
&trans  &kp LT     &kp GT      &kp LPAR     &kp RPAR     &none                          &kp EXCL    &kp QMARK    &kp AMPS    &kp PRCNT    &none       &trans
&trans  &kp LEFT   &kp DOWN    &kp UP       &kp RIGHT    &none                          &kp AT      &kp UNDER    &kp HASH    &kp TILDE    &kp PIPE    &trans
&trans  &kp LBRC   &kp RBRC    &kp LBKT     &kp RBKT     &none     &kp C_MUTE  &none    &kp GRAVE   &kp SQT      &kp DQT     &kp CARET    &kp UP      &trans
&trans  &trans     &trans      &trans       &trans       &trans                         &trans      &trans       &trans      &trans       &trans      &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        // 3. 予備レイヤー
        naginata_layer {
            display-name = "Extra1";
            bindings = <
&trans  &trans  &trans  &trans  &trans     &trans                  &trans  &trans     &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans     &trans                  &trans  &trans     &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans     &trans  &kp C_MUTE &none &trans  &trans     &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &kp SPACE  &trans                  &trans  &kp SPACE  &trans  &trans  &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        // 4. システムレイヤー
        third_layer {
            display-name = "3rd";
            bindings = <
&trans  &kp N1       &kp N2           &kp N3         &kp N4         &kp N5                          &kp N6        &kp N7        &kp N8       &kp N9          &kp N0   &trans
&trans  &kp KP_PLUS  &kp KP_ASTERISK  &kp KP_EQUAL   &kp KP_SLASH   &none                           &kp LS(LEFT)  &kp LS(DOWN)  &kp LS(UP)   &kp LS(RIGHT)   &none    &trans
&trans  &bt BT_SEL 0 &bt BT_SEL 1     &bt BT_SEL 2   &bt BT_CLR     &none   &kp C_MUTE  &none       &kp HOME      &kp PG_DN     &kp PG_UP    &kp END         &kp UP   &trans
&trans  &trans       &trans           &trans         &kp SPACE      &trans                          &trans        &kp SPACE     &trans       &trans          &trans   &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        // 5. 予約レイヤー
        extra2 {
            display-name = "Extra2";
            status = "reserved";
            bindings = <
&trans &trans &trans &trans &trans &trans                  &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans                  &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans                  &trans &trans &trans &trans &trans &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
