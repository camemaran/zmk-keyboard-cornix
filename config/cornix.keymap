#include "zmk-helpers/helper.h"
#include "includes/cornix54.h"
#include "includes/keycode_japanese.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/ext_power.h>
#include <behaviors/naginata.dtsi>

// tap windows for ctl alt and gui

#define HM_TAPPING_TERM 250
#define HM_TAPPING_REPEAT 210

// quick tapping for shift

#define HM_TAPPING_TERM_FAST 200
#define HM_PRIOR_IDLE 70
#define BASE 0
#define LOWER 1
#define RAISE 2
#define NAGINATA 3

// https://github.com/urob/zmk-config/tree/main#timeless-homerow-mods

#define KEYS_L LT0 LT1 LT2 LT3 LT4 LT5 LM0 LM1 LM2 LM3 LM4 LM5 LB0 LB1 LB2 LB3 LB4 LB5  // left hand
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RT5 RM0 RM1 RM2 RM3 RM4 RM5 RB0 RB1 RB2 RB3 RB4 RB5  // right hand
#define THUMBS LH1 LH0 RH0 RH1
#define KEYS_T LH1 LH0 RH0 RH1
#define ZMK_POINTING_DEFAULT_SCRL_VAL 10

/ {
    // Activate ADJUST layer by pressing raise and lower

     macros {
        ng_on: ng_on {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LANGUAGE_1 &kp INTERNATIONAL_4 &to 3>;
        };
        ng_off: ng_off {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LANGUAGE_2 &kp INTERNATIONAL_5 &to 0>;
        };
        macro_caps: macro_caps {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp CAPS>;
        };
// （既存の ng_on, ng_off などのマクロはそのまま残す）

        // ★薙刀式の内部状態をクリアしながら Raise（レイヤー2）へ行くマクロ
        macro_to_l2: macro_to_l2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &ng CLEAR>, <&macro_press &mo 2>, <&macro_pause_for_release>, <&macro_release &mo 2>;
        };

        // ★薙刀式の内部状態をクリアしながら Lower（レイヤー1）へ行くマクロ
        macro_to_l1: macro_to_l1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &ng CLEAR>, <&macro_press &mo 1>, <&macro_pause_for_release>, <&macro_release &mo 1>;
        };

        // ★薙刀式の内部状態をクリアしながら サードレイヤー（レイヤー4）へ行くマクロ
        macro_to_l4: macro_to_l4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &ng CLEAR>, <&macro_press &mo 4>, <&macro_pause_for_release>, <&macro_release &mo 4>;
        };
    };

    behaviors {
        td_shift_caps: tap_dance {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LSHFT>, <&kp CAPSLOCK>;
        };

        hm_l: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <HM_PRIOR_IDLE>;
            hold-trigger-key-positions = <KEYS_R KEYS_T>;
            hold-trigger-on-release;
        };

        hm_r: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <HM_PRIOR_IDLE>;
            hold-trigger-key-positions = <KEYS_L KEYS_T>;
            hold-trigger-on-release;
        };

        hm_shift_l: hm_shift_l {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM_FAST>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <HM_PRIOR_IDLE>;
            hold-trigger-key-positions = <KEYS_R KEYS_T>;
            hold-trigger-on-release;
        };

        hm_shift_r: hm_shift_r {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM_FAST>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <HM_PRIOR_IDLE>;
            hold-trigger-key-positions = <KEYS_L KEYS_T>;
            hold-trigger-on-release;
        };

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <200>;
        };

        // ★標準のレイヤータップ（1文字目が消える対策として hold-preferred を維持）
        lt: layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;
            flavor = "hold-preferred";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <200>;
        };
        
        // ★Control / ESC 用
        mt_esc_ctrl: mt_esc_ctrl {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            retro-tap;
        };

        // ★Raise / TAB 用（長押し・単押し維持＋1文字目消え対策タイマー）
        mt_tab_l2: mt_tab_l2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;
            flavor = "hold-preferred"; 
            tapping-term-ms = <250>;
            quick-tap-ms = <200>;              // これでTABの連打を快適に維持！
            require-prior-idle-ms = <125>;     // 文字入力の直後125msはホールド判定を無効化して1文字目消えを阻止
            retro-tap;
        };

        // ★Lower / BSPC 用（長押し・単押し維持＋1文字目消え対策タイマー）
        mt_del_l1: mt_del_l1 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;
            flavor = "hold-preferred";
            tapping-term-ms = <250>;
            quick-tap-ms = <200>;              // これでBSPCの連打を快適に維持！
            require-prior-idle-ms = <125>;     // 文字入力の直後125msはホールド判定を無効化して1文字目消えを阻止
            retro-tap;
        };

        // ★Command / DEL 用
        mt_ret_cmd: mt_ret_cmd {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            retro-tap;
        };

                // ★ mo_capsを削除し、これを新しく追記
        // レイヤー4用（ホールド優先で1文字目消え対策を適用したシンプルなLayer-Tap）
        lt_l4: lt_l4 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <250>;  // タイミング安定のため250msに統一
            bindings = <&mo>, <&kp>;  // タップ時は通常のキー（またはnone）を出力
        };


// （既存の mt_esc_ctrl, mt_ret_cmd などの定義はそのまま残す）

        // ★英語（Default）レイヤー専用の Raise / TAB（今まで通り完璧に動いているものを固定）
        mt_tab_l2: mt_tab_l2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;
            flavor = "hold-preferred"; 
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            retro-tap;
        };

        // ★英語（Default）レイヤー専用の Lower / BSPC（今まで通り完璧に動いているものを固定）
        mt_del_l1: mt_del_l1 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            retro-tap;
        };

        // ★薙刀式レイヤー専用の「バッファクリア付き」Raise / TAB
        ng_tab_l2: ng_tab_l2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&macro_to_l2>, <&kp>; // 長押しでバッファをクリアしてレイヤー2へ
            flavor = "hold-preferred"; 
            tapping-term-ms = <200>;
            quick-tap-ms = <200>; // 単押し連打（TAB連打）の快適さを維持！
            retro-tap;
        };

        // ★薙刀式レイヤー専用の「バッファクリア付き」Lower / BSPC
        ng_del_l1: ng_del_l1 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&macro_to_l1>, <&kp>; // 長押しでバッファをクリアしてレイヤー1へ
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>; // 単押し連打（BSPC連打）の快適さを維持！
            retro-tap;
        };

        // ★薙刀式レイヤー専用の「バッファクリア付き」サードレイヤー切り替えキー
        // タップ時は何も出力しない（&none）安全仕様です
        ng_l4: ng_l4 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&macro_to_l4>, <&none>; // 長押しでバッファをクリアしてレイヤー4へ、タップは無効
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_ng_on {
            timeout-ms = <300>;
            key-positions = <18 19>; // H, J
            bindings = <&ng_on>;
            layers = <0>;
        };
        combo_ng_off {
            timeout-ms = <300>;
            key-positions = <16 17>; // F, G
            bindings = <&ng_off>;
            layers = <0 3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";

            // -----------------------------------------------------  --------------------------------------キーマップは検討中です。図表は正しくはありません。
            // | TAB   |  Q     |  W  |  E   |  R   |  T   |                   |  Y    |  U    |  I    |  O   |   P   |  ESC |
            // | CTRL  |  A     |  S  |  D   |  F   |  G   |                   |  H    |  J    |  K    |  L   |   -   |  @   |
            // | SHIFT |  Z     |  X  |  C   |  V   |  B   |  MUTE  |  |       |  N    |  M    |  ,    |  .   |   ↑   |  /   |
            // | MO(1) |  MO(2) | GUI |      | ALT  |  F2  |  SPACE |  | ENTER |  BSPC |  DEL  |       |  ←   |   ↓   |  →   |

            bindings = <
&kp TAB         &kp Q   &kp W     &kp E  &kp R     &kp T                          &kp Y      &kp U    &kp I         &kp O       &kp P         &kp BSPC
&ng LCTRL       &kp A   &kp S     &kp D  &kp F     &kp G                          &kp H      &kp J    &kp K         &kp L       &kp MINUS  &kp ENTER
&td_shift_caps  &kp Z   &kp X     &kp C  &kp V     &kp B   &kp C_MUTE  &none      &kp N      &kp M    &kp JP_COMMA  &kp JP_DOT  &kp UP        &kp RSHFT
&mo 4  &kp LALT  &kp LGUI  &mt_esc_ctrl LCTRL ESC  &kp SPACE  &mt_tab_l2 2 TAB  &mt_del_l1 1 BSPC  &kp SPACE  &mt_ret_cmd LGUI DEL  &kp LEFT  &kp DOWN  &kp RIGHT

            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        Lower_layer {
            display-name = "Lower";

            // -----------------------------------------------------  -------------------------------------キーマップは検討中です。図表は正しくはありません。
            // | =     |  /     |  *  |  7   |  8   |  9   |                   |  '    |  (    |  )    |  [    |   ]     |  ^   |
            // | CTRL  |  ,     |  .  |  4   |  5   |  6   |                   |  $    |  %    |  &    |  :    |   ~     |  `   |
            // | SHIFT |  +     |  -  |  1   |  2   |  3   |  MUTE  |  |       |  !    |  "    |  #    |  ;    |   PG_UP |  _   |
            // | MO(1) |  MO(2) | GUI |      | ALT  |  0   |  SPACE |  | ENTER |  BSPC |  DEL  |       |  HOME*|   PG_DN |  END*|

            bindings = <
&trans  &kp LT  &kp GT  &kp LBRC  &kp RBRC  &kp KP_ASTERISK                    &kp COMMA  &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_SLASH  &trans
&trans  &kp LBKT  &kp RBKT  &kp LPAR  &kp RPAR  &kp KP_PLUS                  &kp KP_DOT  &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_MINUS  &trans
&trans  &kp DLLR  &kp RA(BSLH)  &kp COLON  &kp SEMI  &kp KP_EQUAL  &kp C_MUTE  &none  &kp KP_N0  &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp UP  &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans

            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        Raise_layer {
            display-name = "Raise";

            // -------------------------------------------------------------------------  -------------------------------キーマップは検討中です。図表は正しくはありません。------------------------------------
            // | Unlock  |  BT0      |  BT1         |  BT2  |  BT3   |  BT4   |                       |  F7   |  F8   |  F9   |  F10     |         |  |         |
            // | CTRL    |  F15      |  F16         |  F20  |  LANG2 |  LANG1 |                       |  F4   |  F5   |  F6   |  F11     |         |  ¥         |
            // | SHIFT   |  Clear BT |  Clear Peer  |  F21  |        |        |  MUTE    |  |         |  F1   |  F2   |  F3   |  F12     |   MS_UP |  BackSlash |
            // | MO(1)   |  MO(2)    |  GUI         |       |  ALT   |        |  Mouse 1 |  | Mouse 2 |       |       |       |  MS_LEFT |   MS_DN |  MS_RIGHT  |

            bindings = <
&trans  &kp LS(LEFT)  &kp LS(DOWN)  &kp LS(UP)  &kp LS(RIGHT)  &kp ASTERISK  &kp C_AC_DESKTOP_SHOW_ALL_WINDOWS  &kp LG(LS(N3))  &kp LG(LS(N4))  &kp LG(LS(N5))  &kp FSLH  &trans
&trans       &kp LEFT      &kp DOWN        &kp UP        &kp RIGHT      &kp PLUS                         &kp EXCL        &kp QMARK       &kp AMPS        &kp PRCNT       &kp MINUS    &trans
&trans  &kp HOME      &kp PG_DN       &kp PG_UP     &kp END        &kp EQUAL    &kp C_MUTE  &none   &kp UNDER    &kp AT       &kp HASH     &kp TILDE    &kp UP          &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        naginata_layer {
            display-name = "Naginata";

            // Naginata input layer - 31 keys using &ng behavior
            // Same layout as default layer but with &ng bindings
            // Note: Arrow keys are set to &trans so that holding MO(1) (Lower)
            // will surface HOME/END/PG_UP/PG_DN from Layer 1.

            bindings = <
&trans    &ng Q     &ng W     &ng E     &ng R        &ng T                          &ng Y  &ng U  &ng I  &ng O  &ng P  &trans
&trans    &ng A  &ng S  &ng D  &ng F    &ng G                             &ng H      &ng J    &ng K      &ng L     &ng MINUS &trans
&trans    &ng Z  &ng X   &ng C  &ng V  &ng B      &kp C_MUTE  &none      &ng N      &ng M    &ng COMMA  &ng DOT   &kp UP    &trans
&ng_l4 4 0  &kp LALT  &kp LGUI  &mt_esc_ctrl LCTRL ESC  &ng SPACE  &ng_tab_l2 2 TAB  &ng_del_l1 1 BSPC  &ng SPACE  &mt_ret_cmd LGUI DEL  &kp LEFT  &kp DOWN  &kp RIGHT
  
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        third_layer {
            display-name = "3rd";
            bindings = <
&trans         &kp C_BRI_DN   &kp C_BRI_UP    &kp C_AC_DESKTOP_SHOW_ALL_WINDOWS   &kp C_AC_SEARCH    &kp SQT                          &kp CARET  &kp N7   &kp N8   &kp N9   &kp CAPS      &trans
&trans       &kp C_PREV     &kp C_PP        &kp C_NEXT                          &trans             &kp DQT                          &kp PIPE   &kp N4   &kp N5   &kp N6   &trans       &trans
&trans  &bt BT_SEL 0   &bt BT_SEL 1    &bt BT_SEL 2                        &bt BT_CLR         &kp GRAVE  &kp C_MUTE  &none     &kp N0     &kp N1   &kp N2   &kp N3   &kp UP        &trans
&trans  &trans  &trans  &trans  &kp SPACE  &trans  &trans  &kp SPACE  &trans  &trans  &trans  &trans

            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };
        extra2 {
            status = "reserved";
        };
    };
};
